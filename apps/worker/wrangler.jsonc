{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tuktuk",
  // Not a secret; lets CI deploy with just an API token.
  "account_id": "af5fcc7a89393f19f327f80e217e6d80",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Every minute: send the reminders that are due. Daily at 03:00 UTC: clean up abandoned devices.
  "triggers": { "crons": ["* * * * *", "0 3 * * *"] },
  // Device registration is open to anyone: limit it per client IP (approximate, per location).
  "ratelimits": [
    {
      "name": "REGISTRATION_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tuktuk",
      "database_id": "ef310246-1fec-44ad-ad67-57eab2f3c8f7",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    // Origins allowed to call the API (the PWA in production and in dev).
    "ALLOWED_ORIGINS": "https://gnklv.github.io,http://localhost:5180",
    // Web Push (VAPID). The private key is a secret: `wrangler secret put VAPID_PRIVATE_KEY`,
    // and `.dev.vars` for local dev. The subject is a contact URL push services may use.
    "VAPID_PUBLIC_KEY": "BOOdQgk5TD7rIysFWkigFHla2cuCvKVZPIiK_rIgZ2Iv7kzUWnr0sP48f8zJ03F6PEjl5kbFp33LOE9oz54G6cE",
    "VAPID_SUBJECT": "https://gnklv.github.io/tuktuk/",
  },
}
