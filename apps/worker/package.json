{
  "name": "@tuktuk/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "db:migrate:local": "wrangler d1 migrations apply tuktuk --local",
    "db:migrate:remote": "wrangler d1 migrations apply tuktuk --remote"
  },
  "dependencies": {
    "@tuktuk/core": "*",
    "@tuktuk/i18n": "*"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "wrangler": "^4.151.1"
  }
}
